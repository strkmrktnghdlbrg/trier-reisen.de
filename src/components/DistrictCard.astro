---
/** Kachel-Optik (Moselbuehne): Bild vollflaechig, Verlauf, Typo im Bild. */
import ContentImage from "./ContentImage.astro";
import type { District } from "../data/districts";
import { detailPath, localize, type Lang } from "../lib/i18n";

interface Props {
  district: District;
  lang?: Lang;
  span?: "w2" | "h2";
}

const { district: src, lang = "de", span } = Astro.props;
const district = localize("districts", src, lang);
---

<a href={detailPath(lang, "districts", district.slug)} class={`tile${span ? ` ${span}` : ""}`}>
  <div class="pic">
    <ContentImage
      imgKey={district.imageKey}
      fallbackHue={district.hue}
      fallbackLabel={district.name}
      imgClass="w-full h-full object-cover"
      lang={lang}
    />
  </div>
  <div class="veil"></div>
  <div class="cap">
    <h3>{district.name}</h3>
    <span>{district.characterTags.slice(0, 3).join(" · ")}</span>
  </div>
</a>
