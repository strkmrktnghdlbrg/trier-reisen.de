---
/**
 * Kachel-Optik (Moselbuehne). Hotels haben nur generische Poolbilder,
 * kein Foto des Hauses - Poolbilder laufen deshalb IMMER mit sichtbarem
 * Symbolbild-Label. Eigene Fotos (imageKey) ohne Label.
 */
import ContentImage from "./ContentImage.astro";
import { hotelPoolKey, getImage } from "../data/images";
import type { Hotel } from "../data/hotels";
import { getDistrict } from "../data/districts";
import { detailPath, localize, t, type Lang } from "../lib/i18n";

interface Props {
  hotel: Hotel;
  lang?: Lang;
  span?: "w2" | "h2";
}

const { hotel: src, lang = "de", span } = Astro.props;
const hotel = localize("hotels", src, lang);
const district = localize("districts", getDistrict(hotel.district) ?? ({ slug: hotel.district } as any), lang);
const starString = "★".repeat(hotel.stars);
const ownImage = Boolean(hotel.imageKey && getImage(hotel.imageKey));
const imgKey = ownImage ? hotel.imageKey : hotelPoolKey(hotel.slug);
const symText = lang === "en" ? "Symbolic photo" : "Symbolbild";
---

<a href={detailPath(lang, "hotels", hotel.slug)} class={`tile${span ? ` ${span}` : ""}`}>
  <div class="pic">
    <ContentImage
      imgKey={imgKey}
      fallbackHue={hotel.imageHue}
      fallbackLabel={hotel.name}
      imgClass="w-full h-full object-cover"
    />
  </div>
  <div class="veil"></div>
  {!ownImage && getImage(imgKey) && <span class="symlabel">{symText}</span>}
  <span class="tag">{starString}</span>
  <div class="cap">
    <h3>{hotel.name}</h3>
    <span>{district?.name ?? hotel.district} · {t(lang, "sections.priceFrom")} {hotel.priceFrom} €</span>
  </div>
</a>
