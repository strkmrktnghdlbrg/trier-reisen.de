---
/** Kachel-Optik (Moselbuehne): Bild vollflaechig, Verlauf, Typo im Bild. */
import ContentImage from "./ContentImage.astro";
import type { Category } from "../data/categories";
import { detailPath, localize, type Lang } from "../lib/i18n";

interface Props {
  category: Category;
  lang?: Lang;
  span?: "w2" | "h2";
}

const { category: src, lang = "de", span } = Astro.props;
const category = localize("categories", src, lang);
---

<a href={detailPath(lang, "categories", category.slug)} class={`tile${span ? ` ${span}` : ""}`}>
  <div class="pic">
    <ContentImage
      imgKey={`category:${category.slug}`}
      fallbackHue={category.hue}
      fallbackLabel={category.name}
      imgClass="w-full h-full object-cover"
    />
  </div>
  <div class="veil"></div>
  <div class="cap">
    <h3>{category.name}</h3>
    <span>{category.shortDesc}</span>
  </div>
</a>
