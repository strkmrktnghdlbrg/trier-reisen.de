---
/**
 * Kachel-Optik (Moselbuehne). Restaurants haben nur generische Poolbilder -
 * Poolbilder laufen deshalb IMMER mit sichtbarem Symbolbild-Label.
 */
import ContentImage from "./ContentImage.astro";
import { restaurantPoolKey, getImage } from "../data/images";
import type { Restaurant } from "../data/restaurants";
import { getDistrict } from "../data/districts";
import { detailPath, localize, type Lang } from "../lib/i18n";

interface Props {
  restaurant: Restaurant;
  lang?: Lang;
  span?: "w2" | "h2";
}

const { restaurant: src, lang = "de", span } = Astro.props;
const restaurant = localize("restaurants", src, lang);
const district = localize("districts", getDistrict(restaurant.district) ?? ({ slug: restaurant.district } as any), lang);
const ownImage = Boolean(restaurant.imageKey && getImage(restaurant.imageKey));
const imgKey = ownImage ? restaurant.imageKey : restaurantPoolKey(restaurant.slug);
const symText = lang === "en" ? "Symbolic photo" : "Symbolbild";
---

<a href={detailPath(lang, "restaurants", restaurant.slug)} class={`tile${span ? ` ${span}` : ""}`}>
  <div class="pic">
    <ContentImage
      imgKey={imgKey}
      fallbackHue={restaurant.imageHue}
      fallbackLabel={restaurant.name}
      imgClass="w-full h-full object-cover"
      lang={lang}
    />
  </div>
  <div class="veil"></div>
  {!ownImage && getImage(imgKey) && <span class="symlabel">{symText}</span>}
  <span class="tag">{restaurant.priceLevel}</span>
  <div class="cap">
    <h3>{restaurant.name}</h3>
    <span>{district?.name ?? restaurant.district} · {restaurant.cuisine}</span>
  </div>
</a>
