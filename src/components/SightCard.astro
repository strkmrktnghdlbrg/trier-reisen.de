---
/** Kachel-Optik (Moselbuehne): Bild vollflaechig, Verlauf, Typo im Bild. */
import ContentImage from "./ContentImage.astro";
import type { Sight } from "../data/sights";
import { getDistrict } from "../data/districts";
import { detailPath, localize, t, type Lang } from "../lib/i18n";

interface Props {
  sight: Sight;
  lang?: Lang;
  /** Kachelgroesse im Mosaik: "w2" = doppelt breit, "h2" = doppelt hoch. */
  span?: "w2" | "h2";
}

const { sight: src, lang = "de", span } = Astro.props;
const sight = localize("sights", src, lang);
const district = localize("districts", getDistrict(sight.district) ?? ({ slug: sight.district } as any), lang);
const priceLabel =
  sight.priceFrom === null
    ? t(lang, "sections.free")
    : `${t(lang, "sections.priceFrom")} ${sight.priceFrom} €`;
---

<a href={detailPath(lang, "sights", sight.slug)} class={`tile${span ? ` ${span}` : ""}`}>
  <div class="pic">
    <ContentImage
      imgKey={sight.imageKey}
      fallbackHue={sight.imageHue}
      fallbackLabel={sight.name}
      imgClass="w-full h-full object-cover"
      lang={lang}
    />
  </div>
  <div class="veil"></div>
  {sight.unesco && <span class="tag">UNESCO</span>}
  <div class="cap">
    <h3>{sight.name}</h3>
    <span>{district?.name ?? sight.district} · {priceLabel}</span>
  </div>
</a>
