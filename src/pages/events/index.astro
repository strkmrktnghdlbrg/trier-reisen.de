---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import HueGradient from "../../components/HueGradient.astro";
import EventCard from "../../components/EventCard.astro";
import GygActivities from "../../components/GygActivities.astro";
import { city } from "../../data/city";
import { realEvents, seasonalStays, isUpcoming } from "../../data/events";
import { getGyg, gygCmp } from "../../data/gyg";

const upcomingRealEvents = [...realEvents]
  .filter(isUpcoming)
  .sort((a, b) => a.checkin.localeCompare(b.checkin));
const upcomingSeasonal = [...seasonalStays]
  .filter(isUpcoming)
  .sort((a, b) => a.checkin.localeCompare(b.checkin));
const gyg = getGyg("index:events");
---

<BaseLayout
  title={`Events in ${city.name}`}
  altLangPath="/en/events/"
  description={`Events in ${city.name}: Antikenfestspiele, Olewiger Weinfest, Weihnachtsmarkt, Brot und Spiele, Mosel-Wein-Nachts-Bummel. Plus Saison-Hotels für Silvester, Pfingsten, Brueckentage.`}
>
  <section class="container-page py-12">
    <Breadcrumbs items={[{ href: "/", label: city.name }, { label: "Events" }]} />
    <p class="eyebrow mb-3">{upcomingRealEvents.length + upcomingSeasonal.length} Termine</p>
    <h1 class="display-xl">Events & Termine in {city.name}</h1>
    <p class="text-body mt-4 max-w-2xl">
      Antikenfestspiele im Amphitheater, Olewiger Weinfest, Weihnachtsmarkt am Hauptmarkt - Triers grosse Termine plus Saison-Hotels für Silvester und Brueckentage.
    </p>
  </section>

  {upcomingRealEvents.length > 0 && (
    <section class="container-page section pt-0">
      <h2 class="display mb-6">Festivals und Märkte</h2>
      <div class="mosaic m3">
        {upcomingRealEvents.map((e) => <EventCard event={e} />)}
      </div>
    </section>
  )}

  {upcomingSeasonal.length > 0 && (
    <section class="container-page section pt-0">
      <div class="mb-6 max-w-2xl">
        <p class="eyebrow mb-2">Live-Preise</p>
        <h2 class="display mb-2">Saison-Hotels nach Termin</h2>
        <p class="text-body">
          Silvester, Pfingsten, Christi Himmelfahrt, Wochenende - Live-Preise via Booking.com
          für konkrete Reisetermine in Trier.
        </p>
      </div>
      <div class="mosaic m3">
        {upcomingSeasonal.map((e) => (
          <a href={`/hotels-trier-${e.slug}/`} class="tile">
            <div class="pic"><HueGradient hue={2} label={e.title} class="w-full h-full" /></div>
            <div class="veil"></div>
            <span class="tag">{e.eyebrow}</span>
            <div class="cap">
              <h3>{e.title}</h3>
              <span>{e.intro}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {gyg && (
    <div class="container-page">
      <GygActivities q={gyg.q} heading={gyg.heading} intro={gyg.intro} count={gyg.count} cmp={gygCmp("index:events")} />
    </div>
  )}
</BaseLayout>
