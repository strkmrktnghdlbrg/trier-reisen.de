---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StageHero from "../../../components/StageHero.astro";
import ActionDock from "../../../components/ActionDock.astro";
import OsmAttribution from "../../../components/OsmAttribution.astro";
import { city } from "../../../data/city";
import {
  branchenCategories,
  getBranchenCategory,
  listingsByCategory,
  listingGroups,
  categoryHasOsm,
} from "../../../data/branchenverzeichnis";
import "../../../styles/werben.css";

export function getStaticPaths() {
  return branchenCategories.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kategorie = getBranchenCategory(slug!)!;
const listings = listingsByCategory(kategorie.slug);
const premium = listings.filter((l) => l.premium);
const gruppen = listingGroups(kategorie.slug);
const hasOsm = categoryHasOsm(kategorie.slug);

/*
 * Leere Kategorien bleiben erreichbar und verlinkt (sie laden zum ersten
 * Eintrag ein), gehen aber nicht in den Index - sonst waeren es duenne Seiten.
 */
const noindex = listings.length === 0;

const initials = (name: string) =>
  name
    .replace(/[^A-Za-zÄÖÜäöüß ]/g, "")
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase())
    .join("");

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${kategorie.name} in ${city.name}`,
  description: kategorie.description,
  url: `${city.domain}/branchenverzeichnis/kategorie/${kategorie.slug}/`,
};
---

<BaseLayout
  noindex={noindex}
  title={`${kategorie.name} in ${city.name}`}
  description={`${kategorie.name} in ${city.name}: ${listings.length} Einträge aus dem Branchenverzeichnis von Trier Reisen. Kostenloser Eintrag für Betriebe möglich.`}
>
  <StageHero
    imgKey="district:innenstadt"
    badge={`${listings.length} ${listings.length === 1 ? "Eintrag" : "Einträge"}`}
    title={`${kategorie.name} in ${city.name}`}
    lead={kategorie.description}
    minHeight={420}
    crumbs={`Start / Branchenverzeichnis / ${kategorie.name}`}
  />
  <ActionDock
    info={{
      title: "Grundeintrag kostenlos",
      sub: "Premium 199 € pro Jahr netto · 236,81 € brutto · nur für Unternehmer · keine automatische Verlängerung",
    }}
    secondary={{ href: "/werben/premium-partner/", label: "Ganz oben stehen?" }}
    primary={{ href: "/branchenverzeichnis/eintrag-beanspruchen/", label: "Kostenlos eintragen" }}
  />
  <div class="container-page py-12">
    {listings.length > 0 ? (
      <section class="mb-14 max-w-3xl">
        <h2 class="text-2xl font-semibold tracking-tight mb-4" style="color: var(--color-text);">
          Betriebe
        </h2>
        {premium.map((l) => (
          <div class="werben-mock is-premium" style="margin-bottom:0.9rem;">
            <div class="flex items-center justify-between mb-3">
              <p class="eyebrow">Premium-Partner</p>
              <span class="werben-badge">&#9733; Premium</span>
            </div>
            <div class="werben-mock-head">
              <span class="werben-avatar is-premium">{initials(l.name)}</span>
              <div>
                <p class="branchen-item-name">{l.name}</p>
                <p class="branchen-item-meta">
                  {[l.address, l.districtLabel].filter(Boolean).join(" · ")}
                </p>
              </div>
            </div>
            {l.description && (
              <p class="text-sm mt-3" style="color: var(--color-text-body);">{l.description}</p>
            )}
            <div class="werben-mock-actions">
              {l.website && (
                <a class="werben-mock-btn" href={l.website} target="_blank" rel="noopener">Website</a>
              )}
              {l.phone && <span class="werben-mock-btn">{l.phone}</span>}
            </div>
          </div>
        ))}

        {gruppen.map((g) => (
          <div class="branchen-group">
            <h3 class="branchen-group-title">
              {g.label}
              <span class="branchen-group-count">{g.listings.length}</span>
            </h3>
            <div>
              {g.listings.map((l) => (
                <div class="branchen-item">
                  <span class="branchen-item-name">
                    {l.href ? <a href={l.href} class="link-accent">{l.name}</a> : l.name}
                  </span>
                  <span class="branchen-item-meta">
                    {[l.address, l.districtLabel, l.phone].filter(Boolean).join(" · ")}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}

        <p class="werben-muted-note">
          Alle Angaben ohne Gewähr. Adressen stammen aus den verlinkten Beiträgen dieses Portals
          {hasOsm ? " und aus OpenStreetMap" : ""}. Öffnungszeiten und Kontaktdaten können sich
          ändern. Fehler bitte an die
          <a href="/kontakt/" class="link-accent">Redaktion</a> melden.
        </p>
        {hasOsm && <OsmAttribution />}
      </section>
    ) : (
      <section class="werben-card mb-14 max-w-3xl">
        <h2 class="text-xl font-semibold mb-2" style="color: var(--color-text);">
          Noch kein Eintrag in dieser Branche
        </h2>
        <p class="mb-4">
          In {kategorie.name} ist bisher kein Betrieb gelistet. Wer sich jetzt einträgt, steht als Erster
          in dieser Kategorie - der Grundeintrag ist kostenlos.
        </p>
        <a href="/branchenverzeichnis/eintrag-beanspruchen/" class="btn-primary">Als Erster eintragen &rarr;</a>
      </section>
    )}

    <section class="werben-cta-band">
      <h2 class="text-2xl font-semibold tracking-tight mb-3" style="color: var(--color-text);">
        Ihr Betrieb fehlt hier noch?
      </h2>
      <p class="mb-6 max-w-xl mx-auto" style="color: var(--color-text-body);">
        Der Grundeintrag ist kostenlos und dauerhaft. Zwei Minuten Aufwand.
      </p>
      <a href="/branchenverzeichnis/eintrag-beanspruchen/" class="btn-primary">Jetzt kostenlos eintragen &rarr;</a>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline></script>
  </div>
</BaseLayout>

<style>
  .branchen-group { margin-top: 2rem; }
  .branchen-group:first-of-type { margin-top: 0; }
  .branchen-group-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 0.3rem;
  }
  .branchen-group-count {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }
</style>
