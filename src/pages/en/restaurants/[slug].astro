---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StageHero from "../../../components/StageHero.astro";
import ActionDock from "../../../components/ActionDock.astro";
import { heroKey, restaurantPoolKey, getImage } from "../../../data/images";
import RestaurantCard from "../../../components/RestaurantCard.astro";
import { restaurants, type Restaurant } from "../../../data/restaurants";
import { getDistrict } from "../../../data/districts";
import { restaurantSchema, breadcrumbSchema } from "../../../lib/schema";
import { localize, t } from "../../../lib/i18n";
import { city } from "../../../data/city";

export function getStaticPaths() {
  return restaurants.map((restaurant) => ({ params: { slug: restaurant.slug }, props: { restaurant } }));
}

interface Props { restaurant: Restaurant }
const { restaurant: src } = Astro.props;
const lang = "en" as const;
const restaurant = localize("restaurants", src, lang);
const district = localize("districts", getDistrict(src.district) ?? ({ slug: src.district } as any), lang);
const related = restaurants.filter((r) => r.slug !== src.slug && r.cuisine === src.cuisine).slice(0, 3).map((r) => localize("restaurants", r, lang));

/* Image strategy: 1. own photo, 2. district photo (caption names the district,
 * not the restaurant), 3. pool image only with a visible label, 4. placeholder. */
const stageKey = heroKey(src.imageKey, src.district);
const isOwnPhoto = Boolean(stageKey && stageKey === src.imageKey);
const isDistrictPhoto = Boolean(stageKey && !isOwnPhoto);
const poolKey = !stageKey && getImage(restaurantPoolKey(src.slug)) ? restaurantPoolKey(src.slug) : undefined;
const usedKey = stageKey ?? poolKey;
const picNote = isDistrictPhoto ? `District photo: ${district?.name ?? src.district}` : undefined;
---

<BaseLayout
  title={`${restaurant.name} - ${city.name}`}
  description={restaurant.shortDesc}
  lang={lang}
  altLangPath={`/restaurants/${restaurant.slug}/`}
  schema={[
    restaurantSchema(restaurant),
    breadcrumbSchema([
      { name: city.name, url: "/en/" },
      { name: t(lang, "breadcrumb.restaurants"), url: "/en/restaurants/" },
      { name: restaurant.name },
    ]),
  ]}
>
  <article>
    <StageHero
      imgKey={usedKey}
      fallbackHue={src.imageHue}
      badge={restaurant.cuisine}
      title={restaurant.name}
      lead={restaurant.shortDesc}
      minHeight={480}
      crumbs={`Home / Restaurants / ${district?.name ?? src.district}`}
      symbolbild={Boolean(poolKey)}
      picNote={picNote}
      lang={lang}
    >
      <div class="pills">
        <span class="pill-ghost">{district?.name ?? src.district}</span>
        <span class="pill-ghost">{restaurant.priceLevel}</span>
      </div>
    </StageHero>
    <ActionDock
      info={{
        title: restaurant.name,
        sub: [
          restaurant.cuisine,
          restaurant.priceLevel,
          src.openingHours ? "Hours as stated by the operator, as of July 2026" : undefined,
        ].filter(Boolean).join(" · "),
      }}
      secondary={{ href: `/en/districts/${src.district}/`, label: `${district?.name ?? src.district} district` }}
      primary={
        src.websiteUrl
          ? { href: src.websiteUrl, label: src.reservation ? "Reserve a table ↗" : "Official site ↗", external: true }
          : { href: "/en/restaurants/", label: "All restaurants" }
      }
    />

    <div class="container-page py-12">
      <div class="facts4">
        <div>
          <span class="k">Cuisine</span>
          <b>{restaurant.cuisine}</b>
        </div>
        <div>
          <span class="k">Price level</span>
          <b>{restaurant.priceLevel}</b>
        </div>
        <div>
          <span class="k">{t(lang, "sections.district")}</span>
          <b>{district?.name ?? src.district}</b>
        </div>
        {src.openingHours && (
          <div>
            <span class="k">Hours (operator)</span>
            <b>{src.openingHours}</b>
          </div>
        )}
        {!src.openingHours && src.reservation && (
          <div>
            <span class="k">Reservation</span>
            <b>recommended</b>
          </div>
        )}
      </div>

      <div class="max-w-3xl mt-10">
        <p class="text-body text-lg leading-relaxed">{restaurant.longDesc}</p>

        {src.websiteUrl && (
          <p class="mt-6">
            <a href={src.websiteUrl} target="_blank" rel="noopener" class="link-accent">Official site ↗</a>
          </p>
        )}
        {src.reservation && !src.websiteUrl && (
          <p class="mt-6 text-sm" style="color: var(--color-text-muted);">
            Reservation recommended (by phone).
          </p>
        )}
      </div>

      {related.length > 0 && (
        <section class="section">
          <h2 class="display mb-6">More {restaurant.cuisine}</h2>
          <div class="mosaic m3">
            {related.map((r) => <RestaurantCard restaurant={r} lang={lang} />)}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
