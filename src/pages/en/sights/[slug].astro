---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StageHero from "../../../components/StageHero.astro";
import ActionDock from "../../../components/ActionDock.astro";
import SightCard from "../../../components/SightCard.astro";
import Stay22NearbyHotels from "../../../components/Stay22NearbyHotels.astro";
import GygActivities from "../../../components/GygActivities.astro";
import { sights, type Sight } from "../../../data/sights";
import { getDistrict } from "../../../data/districts";
import { getCategory } from "../../../data/categories";
import { getGyg, gygCmp } from "../../../data/gyg";
import { sightSchema, breadcrumbSchema } from "../../../lib/schema";
import { localize, sightEnrichmentsByLang, t } from "../../../lib/i18n";
import { city } from "../../../data/city";

export function getStaticPaths() {
  return sights.map((sight) => ({ params: { slug: sight.slug }, props: { sight } }));
}

interface Props { sight: Sight }
const { sight: src } = Astro.props;
const lang = "en" as const;
const sight = localize("sights", src, lang);
const district = localize("districts", getDistrict(src.district) ?? ({ slug: src.district } as any), lang);
const related = sights
  .filter((s) => s.slug !== src.slug && s.district === src.district)
  .slice(0, 3)
  .map((s) => localize("sights", s, lang));
const cats = src.categories.map((c) => getCategory(c)).filter(Boolean).map((c) => localize("categories", c as any, lang));
const priceLabel = sight.priceFrom === null ? t(lang, "sections.free") : `${t(lang, "sections.priceFrom")} ${sight.priceFrom} €`;
const gygKey = `sight:${sight.slug}`;
const gyg = getGyg(gygKey, "en");
const moreInfo: string[] = (sightEnrichmentsByLang(lang) ?? {})[sight.slug] ?? [];
---

<BaseLayout
  title={sight.name}
  description={sight.shortDesc}
  lang={lang}
  altLangPath={`/sehenswuerdigkeiten/${sight.slug}/`}
  schema={[
    sightSchema(sight),
    breadcrumbSchema([
      { name: city.name, url: "/en/" },
      { name: t(lang, "breadcrumb.sights"), url: "/en/sights/" },
      { name: sight.name },
    ]),
  ]}
>
  <article>
    <StageHero
      imgKey={src.imageKey}
      fallbackHue={src.imageHue}
      badge={src.unesco ? "UNESCO since 1986" : src.type}
      title={sight.name}
      lead={sight.shortDesc}
      minHeight={520}
      crumbs={`Home / Sights / ${district?.name ?? src.district}`}
      lang={lang}
    >
      <div class="pills">
        {src.unesco && <span class="pill-ghost">{src.type}</span>}
        <span class="pill-ghost">{district?.name ?? src.district}</span>
      </div>
    </StageHero>
    <ActionDock
      info={{
        title: priceLabel,
        sub: [
          district?.name ?? src.district,
          src.openingHours ? "Hours as stated by the operator, as of July 2026" : undefined,
        ].filter(Boolean).join(" · "),
      }}
      secondary={{ href: `/en/districts/${src.district}/`, label: `${district?.name ?? src.district} district` }}
      primary={{ href: "#hotels-nearby", label: "Hotels nearby" }}
    />

    <div class="container-page py-12">
      <div class="facts4">
        <div>
          <span class="k">{t(lang, "sections.district")}</span>
          <b>{district?.name ?? src.district}</b>
        </div>
        <div>
          <span class="k">{t(lang, "sections.admission")}</span>
          <b>{priceLabel}</b>
        </div>
        {src.openingHours && (
          <div>
            <span class="k">Hours (operator)</span>
            <b>{src.openingHours}</b>
          </div>
        )}
        {src.websiteUrl ? (
          <div>
            <span class="k">{t(lang, "sections.website")}</span>
            <b><a href={src.websiteUrl} target="_blank" rel="noopener" class="link-accent">Official site ↗</a></b>
          </div>
        ) : (
          <div>
            <span class="k">Category</span>
            <b>{src.type}{src.unesco ? " · UNESCO" : ""}</b>
          </div>
        )}
      </div>

      <div class="max-w-3xl mt-10">
        <p class="text-body text-lg leading-relaxed">{sight.longDesc}</p>
        {moreInfo.map((para) => (
          <p class="text-body mt-4 leading-relaxed">{para}</p>
        ))}

        {cats.length > 0 && (
          <div class="mt-8">
            <p class="eyebrow mb-3">Themes</p>
            <div class="flex flex-wrap gap-2">
              {cats.map((c) => c && <a href={`/en/themes/${c.slug}/`} class="pill hover:border-[var(--color-accent)] transition-colors">{c.name}</a>)}
            </div>
          </div>
        )}
      </div>

      {gyg && (
        <GygActivities q={gyg.q} heading={gyg.heading} intro={gyg.intro} count={gyg.count} cmp={gygCmp(gygKey)} lang="en" />
      )}

      <div id="hotels-nearby">
        <Stay22NearbyHotels lat={src.coordinates[0]} lng={src.coordinates[1]} near={sight.name} radius={1500} limit={4} lang="en" />
      </div>

      {related.length > 0 && (
        <section class="section">
          <h2 class="display mb-6">Nearby</h2>
          <p class="text-body mb-6 max-w-2xl">More in {district?.name ?? src.district}.</p>
          <div class="mosaic m3">
            {related.map((s) => <SightCard sight={s} lang={lang} />)}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
