---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import UnverifiedNotice from "../../../components/UnverifiedNotice.astro";
import StageHero from "../../../components/StageHero.astro";
import ActionDock from "../../../components/ActionDock.astro";
import { heroKey, hotelPoolKey, getImage } from "../../../data/images";
import HotelCard from "../../../components/HotelCard.astro";
import Stay22NearbyHotels from "../../../components/Stay22NearbyHotels.astro";
import { city } from "../../../data/city";
import { hotels, type Hotel, isUnverifiedHotel } from "../../../data/hotels";
import { getDistrict } from "../../../data/districts";
import { hotelSchema, breadcrumbSchema } from "../../../lib/schema";
import { localize, t } from "../../../lib/i18n";

export function getStaticPaths() {
  return hotels.map((hotel) => ({ params: { slug: hotel.slug }, props: { hotel } }));
}

interface Props { hotel: Hotel }
const { hotel: src } = Astro.props;
const lang = "en" as const;
const hotel = localize("hotels", src, lang);
const district = localize("districts", getDistrict(src.district) ?? ({ slug: src.district } as any), lang);
const related = hotels.filter((h) => h.slug !== src.slug && h.district === src.district).slice(0, 3).map((h) => localize("hotels", h, lang));
const stars = "★".repeat(hotel.stars);

/* Image strategy: 1. own photo, 2. district photo (caption names the district,
 * not the property), 3. pool image only with a visible label, 4. placeholder. */
const stageKey = heroKey(src.imageKey, src.district);
const isOwnPhoto = Boolean(stageKey && stageKey === src.imageKey);
const isDistrictPhoto = Boolean(stageKey && !isOwnPhoto);
const poolKey = !stageKey && getImage(hotelPoolKey(src.slug)) ? hotelPoolKey(src.slug) : undefined;
const usedKey = stageKey ?? poolKey;
const picNote = isDistrictPhoto ? `District photo: ${district?.name ?? src.district}` : undefined;

/**
 * Zurueckgezogener Eintrag: die URL loest weiter auf, aber es gehen weder
 * Name noch Beschreibung noch schema.org-Daten raus, und die Seite bekommt
 * noindex. Siehe die Notiz in src/data/hotels.ts.
 */
const unverified = isUnverifiedHotel(src.slug);
---

{unverified ? (
  <BaseLayout title="Entry not available" description="This entry is currently being verified and is temporarily unavailable." noindex>
    <div class="container-page py-12">
      <UnverifiedNotice locale="en" backHref="/en/hotels/" backLabel="Back to hotels" />
    </div>
  </BaseLayout>
) : (

<BaseLayout
  title={`${hotel.name} - ${city.name}`}
  description={hotel.shortDesc}
  lang={lang}
  altLangPath={`/hotels/${hotel.slug}/`}
  schema={[
    hotelSchema(hotel),
    breadcrumbSchema([
      { name: city.name, url: "/en/" },
      { name: t(lang, "breadcrumb.hotels"), url: "/en/hotels/" },
      { name: hotel.name },
    ]),
  ]}
>
  <article>
    <StageHero
      imgKey={usedKey}
      fallbackHue={hotel.imageHue}
      badge={stars}
      title={hotel.name}
      lead={hotel.shortDesc}
      minHeight={480}
      crumbs={`Home / Hotels / ${district?.name ?? src.district}`}
      symbolbild={Boolean(poolKey)}
      picNote={picNote}
      lang={lang}
    >
      <div class="pills">
        <span class="pill-ghost">{district?.name ?? src.district}</span>
      </div>
    </StageHero>
    <ActionDock
      info={{
        title: `${t(lang, "sections.priceFrom")} ${hotel.priceFrom} €`,
        sub: "Live prices and availability on Booking.com · We earn a commission, at no extra cost to you.",
      }}
      secondary={{ href: `/en/districts/${src.district}/`, label: `${district?.name ?? src.district} district` }}
      primary={{ href: hotel.bookingUrl, label: "Check on Booking.com", external: true }}
    />

    <div class="container-page py-12">
      <div class="facts4">
        <div>
          <span class="k">District</span>
          <b>{district?.name ?? src.district}</b>
        </div>
        <div>
          <span class="k">Category</span>
          <b>{stars}</b>
        </div>
        <div>
          <span class="k">Rating</span>
        </div>
        <div>
          <span class="k">Price</span>
          <b>{t(lang, "sections.priceFrom")} {hotel.priceFrom} €</b>
        </div>
      </div>

      <div class="max-w-3xl mt-10">
        <p class="text-body text-lg leading-relaxed">{hotel.longDesc}</p>

        <div class="mt-8">
          <p class="eyebrow mb-3">Amenities</p>
          <div class="flex flex-wrap gap-2">
            {hotel.amenities.map((a) => <span class="pill">{a}</span>)}
          </div>
        </div>
      </div>

      {getDistrict(src.district) && (
        <Stay22NearbyHotels
          lat={getDistrict(src.district)!.coordinates[0]}
          lng={getDistrict(src.district)!.coordinates[1]}
          near={district?.name ?? src.district}
          radius={1500}
          limit={4}
          lang="en"
        />
      )}

      {related.length > 0 && (
        <section class="section">
          <h2 class="display mb-6">More hotels in {district?.name ?? src.district}</h2>
          <div class="mosaic m3">
            {related.map((h) => <HotelCard hotel={h} lang={lang} />)}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
)}
