---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StageHero from "../../components/StageHero.astro";
import ActionDock from "../../components/ActionDock.astro";
import GygActivities from "../../components/GygActivities.astro";
import AwinOffer from "../../components/AwinOffer.astro";
import { guides, type Guide } from "../../data/guides";
import { getGyg, gygCmp } from "../../data/gyg";
import { city } from "../../data/city";

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

interface Props { guide: Guide }
const { guide } = Astro.props;
const gygKey = `guide:${guide.slug}`;
const gyg = getGyg(gygKey);
---

<BaseLayout title={guide.title} description={guide.description} altLangPath={`/en/travel-planner/${guide.slug}/`}>
  <article>
    <StageHero
      imgKey={guide.imageKey}
      fallbackHue={guide.hue}
      badge={guide.eyebrow}
      title={guide.title}
      lead={guide.intro}
      minHeight={480}
      crumbs={`Start / Reiseplaner / ${guide.eyebrow}`}
    />
    <ActionDock
      info={{
        title: guide.eyebrow,
        sub: `${guide.sections.length} Etappen · redaktionell kuratiert`,
      }}
      secondary={{ href: "/reiseplaner/", label: "Alle Reiseplaner" }}
      primary={{ href: "/sehenswuerdigkeiten/", label: "Sehenswürdigkeiten" }}
    />

    <div class="container-page py-12">
      <div class="max-w-3xl">
        {guide.sections.map((sec, i) => (
          <section class="mb-10">
            <p class="eyebrow mb-2">Schritt {i + 1}</p>
            <h2 class="display mb-4">{sec.heading}</h2>
            <p class="text-body text-lg leading-relaxed">{sec.body}</p>
          </section>
        ))}
      </div>

      <div class="max-w-3xl">
        <AwinOffer
          merchants={["deutsche-bahn", "flixbus"]}
          heading="Anreise nach Trier"
          intro="Planen Sie die Fahrt in die älteste Stadt Deutschlands: Mit der Bahn direkt zum Hauptbahnhof oder günstig per Fernbus. Tickets bei unseren Reisepartnern buchen."
          clickref="reiseplaner"
        />
      </div>

      {gyg && (
        <GygActivities q={gyg.q} heading={gyg.heading} intro={gyg.intro} count={gyg.count} cmp={gygCmp(gygKey)} />
      )}
    </div>
  </article>
</BaseLayout>
