---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StageHero from "../../components/StageHero.astro";
import ActionDock from "../../components/ActionDock.astro";
import { heroKey, hotelPoolKey, getImage } from "../../data/images";
import HotelCard from "../../components/HotelCard.astro";
import SightCard from "../../components/SightCard.astro";
import Stay22NearbyHotels from "../../components/Stay22NearbyHotels.astro";
import { city } from "../../data/city";
import { hotels, type Hotel } from "../../data/hotels";
import { sights } from "../../data/sights";
import { getDistrict } from "../../data/districts";
import { hotelSchema, breadcrumbSchema } from "../../lib/schema";

export function getStaticPaths() {
  return hotels.map((hotel) => ({ params: { slug: hotel.slug }, props: { hotel } }));
}

interface Props { hotel: Hotel }
const { hotel } = Astro.props;
const district = getDistrict(hotel.district);
const related = hotels.filter((h) => h.slug !== hotel.slug && h.district === hotel.district).slice(0, 3);
const nearbySights = sights.filter((s) => s.district === hotel.district).slice(0, 3);
const stars = "★".repeat(hotel.stars);

/*
 * Bildstrategie: 1. eigenes Foto, 2. Stadtteilfoto (Bildunterschrift nennt den
 * Stadtteil, nicht den Betrieb), 3. Poolbild NUR mit sichtbarem Symbolbild-Label,
 * 4. designter Platzhalter.
 */
const stageKey = heroKey(hotel.imageKey, hotel.district);
const isOwnPhoto = Boolean(stageKey && stageKey === hotel.imageKey);
const isDistrictPhoto = Boolean(stageKey && !isOwnPhoto);
const poolKey = !stageKey && getImage(hotelPoolKey(hotel.slug)) ? hotelPoolKey(hotel.slug) : undefined;
const usedKey = stageKey ?? poolKey;
const picNote = isDistrictPhoto
  ? `Stadtteilfoto: ${district?.name ?? hotel.district}`
  : undefined;
---

<BaseLayout
  title={`${hotel.name} - ${city.name}`}
  description={hotel.shortDesc}
  altLangPath={`/en/hotels/${hotel.slug}/`}
  schema={[
    hotelSchema(hotel),
    breadcrumbSchema([
      { name: city.name, url: "/" },
      { name: "Hotels", url: "/hotels/" },
      { name: hotel.name },
    ]),
  ]}
>
  <article>
    <StageHero
      imgKey={usedKey}
      fallbackHue={hotel.imageHue}
      badge={stars}
      title={hotel.name}
      lead={hotel.shortDesc}
      minHeight={480}
      crumbs={`Start / Hotels / ${district?.name ?? hotel.district}`}
      symbolbild={Boolean(poolKey)}
      picNote={picNote}
    >
      <div class="pills">
        <span class="pill-ghost">{district?.name ?? hotel.district}</span>
        <span class="pill-ghost">⭐ {hotel.rating}/10 · {hotel.reviews} Bewertungen</span>
      </div>
    </StageHero>
    <ActionDock
      info={{
        title: `ab ${hotel.priceFrom} €`,
        sub: "Preise und Verfügbarkeit live auf Booking.com · Wir erhalten beim Klick eine Provision - der Preis bleibt für dich gleich.",
      }}
      secondary={{ href: `/bezirke/${hotel.district}/`, label: `Stadtteil ${district?.name ?? hotel.district}` }}
      primary={{ href: hotel.bookingUrl, label: "Auf Booking.com prüfen", external: true }}
    />

    <div class="container-page py-12">
      <div class="facts4">
        <div>
          <span class="k">Stadtteil</span>
          <b>{district?.name ?? hotel.district}</b>
        </div>
        <div>
          <span class="k">Kategorie</span>
          <b>{stars}</b>
        </div>
        <div>
          <span class="k">Bewertung</span>
          <b>{hotel.rating}/10 · {hotel.reviews} Bewertungen</b>
        </div>
        <div>
          <span class="k">Preis</span>
          <b>ab {hotel.priceFrom} €</b>
        </div>
      </div>

      <div class="max-w-3xl mt-10">
        <p class="text-body text-lg leading-relaxed">{hotel.longDesc}</p>

        <div class="mt-8">
          <p class="eyebrow mb-3">Ausstattung</p>
          <div class="flex flex-wrap gap-2">
            {hotel.amenities.map((a) => <span class="pill">{a}</span>)}
          </div>
        </div>
      </div>

      {district && (
        <Stay22NearbyHotels
          lat={district.coordinates[0]}
          lng={district.coordinates[1]}
          near={district.name}
          radius={1500}
          limit={4}
        />
      )}

      {nearbySights.length > 0 && (
        <section class="section">
          <h2 class="display mb-6">Sehenswürdigkeiten in der Nähe</h2>
          <div class="mosaic m3">
            {nearbySights.map((s) => <SightCard sight={s} />)}
          </div>
        </section>
      )}

      {related.length > 0 && (
        <section class="section pt-0">
          <h2 class="display mb-6">Weitere Hotels in {district?.name ?? hotel.district}</h2>
          <div class="mosaic m3">
            {related.map((h) => <HotelCard hotel={h} />)}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
