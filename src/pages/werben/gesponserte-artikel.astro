---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StageHero from "../../components/StageHero.astro";
import ActionDock from "../../components/ActionDock.astro";
import { city } from "../../data/city";
import "../../styles/werben.css";

const title = "Gesponserte Artikel";
const description = `Ein redaktionell aufbereiteter Beitrag über Ihren Betrieb auf Trier Reisen - dauerhaft online, als Werbung gekennzeichnet, mit Dofollow-Verlinkung.`;

const leistungen = [
  {
    eyebrow: "Redaktionell aufbereitet",
    title: "Wir schreiben, Sie geben frei",
    body: "Sie liefern die Eckdaten, wir bringen sie in die Form des Portals. Vor Veröffentlichung bekommen Sie den Text zur Freigabe.",
  },
  {
    eyebrow: "Dauerhaft",
    title: "Bleibt online",
    body: "Der Beitrag wird nicht nach ein paar Wochen entfernt, sondern bleibt dauerhaft Teil des Portals und intern verlinkt.",
  },
  {
    eyebrow: "Sichtbar",
    title: "Mit Dofollow-Link",
    body: "Aus dem Beitrag verlinken wir auf Ihre Website - regulär dofollow, nicht auf 'sponsored' gesetzt.",
  },
];

const ablauf = [
  { t: "Briefing", b: "Sie schicken uns Eckdaten, Bildmaterial und Ihre Wunschbotschaft." },
  { t: "Entwurf", b: "Wir schreiben den Beitrag im Stil des Portals und legen ihn Ihnen vor." },
  { t: "Freigabe & Live", b: "Nach Ihrer Freigabe geht der Artikel online - gekennzeichnet als Anzeige." },
];

const faqs = [
  {
    q: "Wird der Beitrag als Werbung gekennzeichnet?",
    a: "Ja. Gesponserte Beiträge werden klar als Anzeige bzw. Werbung gekennzeichnet. Das schreibt das Trennungsgebot vor und schafft Vertrauen bei den Leserinnen und Lesern.",
  },
  {
    q: "Was kostet ein gesponserter Artikel?",
    a: "Das hängt vom Umfang ab. Im Premium-Paket (199 € pro Jahr netto) ist ein Beitrag pro Jahr bereits enthalten. Einzelbuchungen kalkulieren wir auf Anfrage.",
  },
  {
    q: "Darf ich den Text selbst liefern?",
    a: "Ja, ein fertiger Text ist möglich - wir passen ihn redaktionell an das Portal an und prüfen ihn auf rechtliche Stolperfallen, etwa unzulässige Werbeaussagen.",
  },
  {
    q: "Welche Themen sind ausgeschlossen?",
    a: "Wir veröffentlichen keine Beiträge mit irreführenden Werbeaussagen, keine Inhalte aus rechtlich heiklen Branchen ohne Nachweis und nichts, was nicht zu einem Stadtportal passt.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout title={title} description={description}>
  <StageHero
    imgKey="sight:hauptmarkt"
    badge="Redaktioneller Beitrag"
    title="Ein Beitrag, der bleibt."
    lead="Ein gesponserter Artikel erzählt die Geschichte Ihres Betriebs im Stil des Portals - und bleibt dauerhaft online, statt nach zwei Wochen aus dem Werbeblock zu verschwinden. Inklusive Verlinkung auf Ihre Website und interner Verlinkung aus passenden Beiträgen."
    minHeight={460}
    crumbs="Start / Werben / Gesponserte Artikel"
  />
  <ActionDock
    info={{
      title: "Im Premium-Paket enthalten",
      sub: "199 € pro Jahr netto · 236,81 € brutto · nur für Unternehmer · keine automatische Verlängerung",
    }}
    secondary={{ href: "/werben/premium-partner/", label: "Premium-Paket ansehen" }}
    primary={{ href: "/kontakt/", label: "Beitrag anfragen" }}
  />
  <div class="container-page py-12">
    <section class="mb-16">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-6" style="color: var(--color-text);">Was Sie bekommen</h2>
      <div class="werben-grid werben-grid-3">
        {leistungen.map((l) => (
          <div class="werben-card">
            <p class="eyebrow mb-2">{l.eyebrow}</p>
            <h3 class="text-lg font-semibold" style="color: var(--color-text);">{l.title}</h3>
            <p>{l.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-6" style="color: var(--color-text);">So läuft es ab</h2>
      <div class="werben-grid werben-grid-3">
        {ablauf.map((s, i) => (
          <div class="werben-card">
            <span class="werben-step-num">{i + 1}</span>
            <h3 class="text-base font-semibold" style="color: var(--color-text);">{s.t}</h3>
            <p>{s.b}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-16 max-w-3xl">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-4" style="color: var(--color-text);">Häufige Fragen</h2>
      <div class="werben-faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="werben-cta-band">
      <h2 class="text-2xl font-semibold tracking-tight mb-3" style="color: var(--color-text);">
        Erzählen Sie uns von Ihrem Betrieb.
      </h2>
      <p class="mb-6 max-w-xl mx-auto" style="color: var(--color-text-body);">
        Kurze Nachricht genügt - wir melden uns mit Vorschlag, Umfang und Preis zurück.
        Das Angebot richtet sich ausschließlich an Unternehmer.
      </p>
      <a href="/kontakt/" class="btn-primary">Beitrag anfragen &rarr;</a>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline></script>
  </div>
</BaseLayout>
