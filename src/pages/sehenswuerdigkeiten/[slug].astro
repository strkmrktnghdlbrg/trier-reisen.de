---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StageHero from "../../components/StageHero.astro";
import ActionDock from "../../components/ActionDock.astro";
import SightCard from "../../components/SightCard.astro";
import Stay22NearbyHotels from "../../components/Stay22NearbyHotels.astro";
import GygActivities from "../../components/GygActivities.astro";
import { sights, type Sight } from "../../data/sights";
import { getDistrict } from "../../data/districts";
import { getCategory } from "../../data/categories";
import { getGyg, gygCmp } from "../../data/gyg";
import sightEnrichments from "../../data/sight-enrichments.json";
import { sightSchema, breadcrumbSchema, faqSchema } from "../../lib/schema";
import { city } from "../../data/city";

export function getStaticPaths() {
  return sights.map((sight) => ({ params: { slug: sight.slug }, props: { sight } }));
}

interface Props { sight: Sight }
const { sight } = Astro.props;
const district = getDistrict(sight.district);
const related = sights.filter((s) => s.slug !== sight.slug && s.district === sight.district).slice(0, 3);
const cats = sight.categories.map((c) => getCategory(c)).filter(Boolean);
const priceLabel = sight.priceFrom === null ? "Eintritt frei" : `ab ${sight.priceFrom} €`;
const gygKey = `sight:${sight.slug}`;
const gyg = getGyg(gygKey);
const moreInfo: string[] = (sightEnrichments as Record<string, string[]>)[sight.slug] ?? [];
---

<BaseLayout
  title={sight.name}
  description={sight.shortDesc}
  altLangPath={`/en/sights/${sight.slug}/`}
  schema={[
    sightSchema(sight),
    breadcrumbSchema([
      { name: city.name, url: "/" },
      { name: "Sehenswürdigkeiten", url: "/sehenswuerdigkeiten/" },
      { name: sight.name },
    ]),
    ...(sight.faq && sight.faq.length > 0 ? [faqSchema(sight.faq)] : []),
  ]}
>
  <article>
    <StageHero
      imgKey={sight.imageKey}
      fallbackHue={sight.imageHue}
      badge={sight.unesco ? "UNESCO seit 1986" : sight.type}
      title={sight.name}
      lead={sight.shortDesc}
      minHeight={520}
      crumbs={`Start / Sehenswürdigkeiten / ${district?.name ?? sight.district}`}
    >
      <div class="pills">
        {sight.unesco && <span class="pill-ghost">{sight.type}</span>}
        <span class="pill-ghost">{district?.name ?? sight.district}</span>
      </div>
    </StageHero>
    <ActionDock
      info={{
        title: priceLabel,
        sub: [
          district?.name ?? sight.district,
          sight.openingHours ? "Öffnung laut Betreiber, Stand Juli 2026" : undefined,
        ].filter(Boolean).join(" · "),
      }}
      secondary={{ href: `/bezirke/${sight.district}/`, label: `Stadtteil ${district?.name ?? sight.district}` }}
      primary={{ href: "#hotels-nahe", label: "Hotels in der Nähe" }}
    />

    <div class="container-page py-12">
      <div class="facts4">
        <div>
          <span class="k">Stadtteil</span>
          <b>{district?.name ?? sight.district}</b>
        </div>
        <div>
          <span class="k">Eintritt</span>
          <b>{priceLabel}</b>
        </div>
        {sight.openingHours && (
          <div>
            <span class="k">Öffnung laut Betreiber</span>
            <b>{sight.openingHours}</b>
          </div>
        )}
        {sight.websiteUrl ? (
          <div>
            <span class="k">Website</span>
            <b><a href={sight.websiteUrl} target="_blank" rel="noopener" class="link-accent">Offizielle Seite ↗</a></b>
          </div>
        ) : (
          <div>
            <span class="k">Kategorie</span>
            <b>{sight.type}{sight.unesco ? " · UNESCO" : ""}</b>
          </div>
        )}
      </div>

      <div class="max-w-3xl mt-10">
        <p class="text-body text-lg leading-relaxed">{sight.longDesc}</p>
        {moreInfo.map((para) => (
          <p class="text-body mt-4 leading-relaxed">{para}</p>
        ))}

        {cats.length > 0 && (
          <div class="mt-8">
            <p class="eyebrow mb-3">Themen</p>
            <div class="flex flex-wrap gap-2">
              {cats.map((c) => c && <a href={`/kategorien/${c.slug}/`} class="pill hover:border-[var(--color-accent)] transition-colors">{c.name}</a>)}
            </div>
          </div>
        )}
      </div>

      {gyg && (
        <GygActivities
          q={gyg.q}
          heading={gyg.heading}
          intro={gyg.intro}
          count={gyg.count}
          cmp={gygCmp(gygKey)}
        />
      )}

      <div id="hotels-nahe">
        <Stay22NearbyHotels
          lat={sight.coordinates[0]}
          lng={sight.coordinates[1]}
          near={sight.name}
          radius={1500}
          limit={4}
        />
      </div>

      {sight.faq && sight.faq.length > 0 && (
        <section class="max-w-3xl mt-14">
          <h2 class="display mb-6">Häufige Fragen zu {sight.name}</h2>
          <div class="space-y-5">
            {sight.faq.map((f) => (
              <div>
                <h3 class="text-lg font-medium mb-1" style="color: var(--color-text);">{f.q}</h3>
                <p class="text-body" set:html={f.a} />
              </div>
            ))}
          </div>
        </section>
      )}

      {related.length > 0 && (
        <section class="section">
          <h2 class="display mb-6">In der Umgebung</h2>
          <p class="text-body mb-6 max-w-2xl">Weiter in {district?.name ?? sight.district}.</p>
          <div class="mosaic m3">
            {related.map((s) => <SightCard sight={s} />)}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
