---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UnverifiedNotice from "../../components/UnverifiedNotice.astro";
import StageHero from "../../components/StageHero.astro";
import ActionDock from "../../components/ActionDock.astro";
import { heroKey, restaurantPoolKey, getImage } from "../../data/images";
import RestaurantCard from "../../components/RestaurantCard.astro";
import SightCard from "../../components/SightCard.astro";
import { restaurants, publishedRestaurants, type Restaurant, isUnverifiedRestaurant } from "../../data/restaurants";
import { sights } from "../../data/sights";
import { getDistrict } from "../../data/districts";
import { restaurantSchema, breadcrumbSchema } from "../../lib/schema";
import { city } from "../../data/city";

export function getStaticPaths() {
  return restaurants.map((restaurant) => ({ params: { slug: restaurant.slug }, props: { restaurant } }));
}

interface Props { restaurant: Restaurant }
const { restaurant } = Astro.props;
const district = getDistrict(restaurant.district);
const related = publishedRestaurants.filter((r) => r.slug !== restaurant.slug && r.cuisine === restaurant.cuisine).slice(0, 3);
const nearbySights = sights.filter((s) => s.district === restaurant.district).slice(0, 3);

/*
 * Bildstrategie: 1. eigenes Foto, 2. Stadtteilfoto (Bildunterschrift nennt den
 * Stadtteil, nicht den Betrieb), 3. Poolbild NUR mit sichtbarem Symbolbild-Label,
 * 4. designter Platzhalter.
 */
const stageKey = heroKey(restaurant.imageKey, restaurant.district);
const isOwnPhoto = Boolean(stageKey && stageKey === restaurant.imageKey);
const isDistrictPhoto = Boolean(stageKey && !isOwnPhoto);
const poolKey = !stageKey && getImage(restaurantPoolKey(restaurant.slug)) ? restaurantPoolKey(restaurant.slug) : undefined;
const usedKey = stageKey ?? poolKey;
const picNote = isDistrictPhoto
  ? `Stadtteilfoto: ${district?.name ?? restaurant.district}`
  : undefined;

/**
 * Zurueckgezogener Eintrag: die URL loest weiter auf, aber es gehen weder
 * Name noch Beschreibung noch schema.org-Daten raus, und die Seite bekommt
 * noindex. Siehe die Notiz in src/data/restaurants.ts.
 */
const unverified = isUnverifiedRestaurant(restaurant.slug);
---

{unverified ? (
  <BaseLayout title="Eintrag nicht verfügbar" description="Dieser Eintrag wird derzeit überprüft und ist vorübergehend nicht verfügbar." noindex>
    <div class="container-page py-12">
      <UnverifiedNotice backHref="/restaurants/" backLabel="Zur Restaurant-Übersicht" />
    </div>
  </BaseLayout>
) : (

<BaseLayout
  title={`${restaurant.name} - ${city.name}`}
  description={restaurant.shortDesc}
  altLangPath={`/en/restaurants/${restaurant.slug}/`}
  schema={[
    restaurantSchema(restaurant),
    breadcrumbSchema([
      { name: city.name, url: "/" },
      { name: "Restaurants", url: "/restaurants/" },
      { name: restaurant.name },
    ]),
  ]}
>
  <article>
    <StageHero
      imgKey={usedKey}
      fallbackHue={restaurant.imageHue}
      badge={restaurant.cuisine}
      title={restaurant.name}
      lead={restaurant.shortDesc}
      minHeight={480}
      crumbs={`Start / Restaurants / ${district?.name ?? restaurant.district}`}
      symbolbild={Boolean(poolKey)}
      picNote={picNote}
    >
      <div class="pills">
        <span class="pill-ghost">{district?.name ?? restaurant.district}</span>
        <span class="pill-ghost">{restaurant.priceLevel}</span>
      </div>
    </StageHero>
    <ActionDock
      info={{
        title: restaurant.name,
        sub: [
          restaurant.cuisine,
          restaurant.priceLevel,
          restaurant.openingHours ? "Zeiten laut Betreiber, Stand Juli 2026" : undefined,
        ].filter(Boolean).join(" · "),
      }}
      secondary={{ href: `/bezirke/${restaurant.district}/`, label: `Stadtteil ${district?.name ?? restaurant.district}` }}
      primary={
        restaurant.websiteUrl
          ? { href: restaurant.websiteUrl, label: restaurant.reservation ? "Tisch beim Restaurant reservieren ↗" : "Offizielle Seite ↗", external: true }
          : { href: "/restaurants/", label: "Alle Restaurants" }
      }
    />

    <div class="container-page py-12">
      <div class="facts4">
        <div>
          <span class="k">Küche</span>
          <b>{restaurant.cuisine}</b>
        </div>
        <div>
          <span class="k">Preisniveau</span>
          <b>{restaurant.priceLevel}</b>
        </div>
        <div>
          <span class="k">Stadtteil</span>
          <b>
            {district ? (
              <a href={`/bezirke/${district.slug}/`} class="link-accent">{district.name}</a>
            ) : (
              restaurant.district
            )}
          </b>
        </div>
        {restaurant.openingHours && (
          <div>
            <span class="k">Zeiten laut Betreiber</span>
            <b>{restaurant.openingHours}</b>
          </div>
        )}
        {!restaurant.openingHours && restaurant.reservation && (
          <div>
            <span class="k">Reservierung</span>
            <b>empfohlen</b>
          </div>
        )}
      </div>

      <div class="max-w-3xl mt-10">
        <p class="text-body text-lg leading-relaxed">{restaurant.longDesc}</p>

        {restaurant.websiteUrl && (
          <p class="mt-6">
            <a href={restaurant.websiteUrl} target="_blank" rel="noopener" class="link-accent">Offizielle Seite ↗</a>
          </p>
        )}
        {restaurant.reservation && !restaurant.websiteUrl && (
          <p class="mt-6 text-sm" style="color: var(--color-text-muted);">
            Reservierung empfohlen (telefonisch).
          </p>
        )}
      </div>

      {nearbySights.length > 0 && (
        <section class="section">
          <h2 class="display mb-6">Sehenswürdigkeiten in der Nähe</h2>
          <div class="mosaic m3">
            {nearbySights.map((s) => <SightCard sight={s} />)}
          </div>
        </section>
      )}

      {related.length > 0 && (
        <section class="section pt-0">
          <h2 class="display mb-6">Mehr {restaurant.cuisine}</h2>
          <div class="mosaic m3">
            {related.map((r) => <RestaurantCard restaurant={r} />)}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
)}
